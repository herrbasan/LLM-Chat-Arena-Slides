node_modules/

# Local service configuration
server/.env
server/.env.local

# Runtime project data and generated render artifacts
server/data/
server/slideshows.jsonl
pipeline/output/

# Root-level archive (kept on disk, not tracked). Files we want to
# preserve locally but not publish (e.g. the old `client/` attempt
# that was superseded by `web/`). The leading slash means this only
# matches `_Archive/` at the repo root — `docs/_Archive/` is still
# tracked and ships with the repo.
/_Archive/

# Baked web exports (artifacts) and the generated listing
/web-export/convos/
/web-export/index.html

# Video render output. A full deck is thousands of captured frames plus an
# encoded MP4 — build artifacts, never sources.
# (The recorder lives in its own repo since 2026-10-01:
# D:\Work\GIT\screen-record; the Arena capture harness is archived there in
# _Archive/capture/.)
/captures/
