# ============================================
# Server & External Integration Configuration
# ============================================

# Local Server Settings
PORT=3600
NODE_ENV=development

# External Integrations
# nSpeech (text clean + TTS + forced alignment, V3 API). Required for import + render.
NSPEECH_URL=http://192.168.0.100:2233

# LLM Gateway — only used by the editor's chat sidebar. Optional.
LLM_GATEWAY_URL=http://192.168.0.100:3400
# LLM_GATEWAY_API_KEY=

# Voice Configuration (blended voices from nSpeech)
VOICE_NARRATOR=Adam_Eric
VOICE_NARRATOR_SPEED=0.95
VOICE_PARTICIPANT_A=Kimi
VOICE_PARTICIPANT_A_SPEED=1.0
VOICE_PARTICIPANT_B=GLM
VOICE_PARTICIPANT_B_SPEED=1.0

# nDB Settings
NDB_DATA_PATH=./data